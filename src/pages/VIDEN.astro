---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="VIDEN | My Portfolio" page="viden">

  <div class="page-wrapper">

    <!-- Tilbage knap -->
    <div class="fade-in" style="padding-top: 2rem;">
      <a href="/projects" class="proj-back-btn">← Projects</a>
    </div>

    <!-- TITEL -->
    <div style="
      font-size: clamp(1rem, 5vw, 5rem); 
      font-weight: 900;
      line-height: 0.85;
      letter-spacing: -0.05em;
      color: transparent !important;
      -webkit-text-stroke: 2px #ffffff;
      pointer-events: none;
      word-break: break-word;
      text-align: center;
      margin-top: 2rem;
    ">HAVET UNDER PRESS</div>

    <!-- Tags -->
    <div class="fade-in" style="display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center; padding: 1rem 0 2rem;">
      <span class="proj-tag whitespace-nowrap">Game Design</span>
      <span class="proj-tag whitespace-nowrap">Education</span>
      <span class="proj-tag whitespace-nowrap">Astro</span>
      <span class="proj-tag whitespace-nowrap">JavaScript</span>
    </div>

<!-- VIDEO -->
<div class="proj-gallery-full overflow-hidden mb-8 fade-in">
  <video autoplay muted loop playsinline
         style="width: 100%; height: 100%; object-fit: cover; ">
    <source src="/Billeder/VIDEN/Videnvideo.mp4" type="video/mp4" />
  </video>
</div>

    <!-- ===== PROJEKT INDHOLD ===== -->
    <div id="projekt">

      <!-- SEKTION 1: Intro -->
      <div class="fade-in mb-16">
      <p class="text-base sm:text-lg text-gray-200 leading-relaxed">
  Havet under pres is an interactive educational game developed for Videnskab.dk. The game is aimed at children aged 5–10 and focuses on marine pollution and the importance of protecting the ocean.
</p>
<p class="text-base sm:text-lg text-gray-200 leading-relaxed">
  This walkthrough demonstrates the interactive gameplay, showing how players progress through the three environments.
</p>
      </div>

      <!-- SEKTION 2: Generatoren — tekst + karusel side om side -->
      <div class="fade-in mb-16 flex flex-col lg:flex-row gap-8 items-start">

        <!-- Tekst -->
        <div class="lg:w-1/2 flex flex-col gap-4">
         <h2 style="
  color: #ffffff;
  font-size: 1.1rem;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  text-shadow: 2px 2px 0 #000, -2px -2px 0 #000, 2px -2px 0 #000, -2px 2px 0 #000, 2px 0 0 #000, -2px 0 0 #000, 0 2px 0 #000, 0 -2px 0 #000;
">The game</h2>

<p class="text-base sm:text-lg text-gray-200 leading-relaxed">
  The game consists of three levels: the beach, the ocean surface, and the seabed. Each level represents a different marine habitat with its own animals, plants, and objects.
</p>

<p class="text-base sm:text-lg text-gray-200 leading-relaxed">
  The player explores each environment by finding the correct objects while learning about the species that live there and how pollution affects their habitat.
</p>

<p class="text-base sm:text-lg text-gray-200 leading-relaxed">
  The project combines illustrations, animations, audio, and interactive elements to communicate scientific knowledge in a format suited for children.
</p>
        </div>

        <!-- Stilbillede -->
        <div class="lg:w-1/2">
          <img id="still-billede" src="/Billeder/VIDEN/BANE2.png" class="cursor-pointer hover:opacity-80 transition-opacity duration-300" style="width: 100%; height: 100%;" />
        </div>

      </div>

<!-- SEKTION: Karusel -->
      <div class="fade-in mb-16">
        <div class="relative overflow-hidden">
          <div id="karusel" class="flex transition-transform duration-500 ease-in-out">
            <img src="/Billeder/VIDEN/videnhero.png" class="karusel-billede flex-shrink-0 object-contain cursor-pointer hover:opacity-80 transition-opacity duration-300" style="height: 440px; background: #8DB8DA;" />
            <img src="/Billeder/VIDEN/hjul1.png" class="karusel-billede flex-shrink-0 object-contain cursor-pointer hover:opacity-80 transition-opacity duration-300" style="height: 440px; background: #DFE3DC;" />
            <img src="/Billeder/VIDEN/hjul2.png" class="karusel-billede flex-shrink-0 object-contain cursor-pointer hover:opacity-80 transition-opacity duration-300" style="height: 440px; background: #DFE3DC;" />
            <img src="/Billeder/VIDEN/hjul3.png" class="karusel-billede flex-shrink-0 object-contain cursor-pointer hover:opacity-80 transition-opacity duration-300" style="height: 440px; background: #DFE3DC;" />
            <img src="/Billeder/VIDEN/hjul4.png" class="karusel-billede flex-shrink-0 object-contain cursor-pointer hover:opacity-80 transition-opacity duration-300" style="height: 440px; background: #DFE3DC;" />
            <img src="/Billeder/VIDEN/hjul5.png" class="karusel-billede flex-shrink-0 object-contain cursor-pointer hover:opacity-80 transition-opacity duration-300" style="height: 440px; background: #DFE3DC;" />
            <img src="/Billeder/VIDEN/hjul6.png" class="karusel-billede flex-shrink-0 object-contain cursor-pointer hover:opacity-80 transition-opacity duration-300" style="height: 440px; background: #DFE3DC;" />
            <img src="/Billeder/VIDEN/hjul7.png" class="karusel-billede flex-shrink-0 object-contain cursor-pointer hover:opacity-80 transition-opacity duration-300" style="height: 440px; background: #DFE3DC;" />
            <img src="/Billeder/VIDEN/hjul8.png" class="karusel-billede flex-shrink-0 object-contain cursor-pointer hover:opacity-80 transition-opacity duration-300" style="height: 440px; background: #DFE3DC;" />
            <img src="/Billeder/VIDEN/hjul9.png" class="karusel-billede flex-shrink-0 object-contain cursor-pointer hover:opacity-80 transition-opacity duration-300" style="height: 440px; background: #DFE3DC;" />
          </div>
          <button id="aboutPrev" class="absolute left-4 top-1/2 -translate-y-1/2 text-black px-4 py-3 transition-all duration-300 hover:scale-140 text-xl font-bold z-10">◀</button>
          <button id="aboutNext" class="absolute right-4 top-1/2 -translate-y-1/2 text-black px-4 py-3 transition-all duration-300 hover:scale-140 text-xl font-bold z-10">▶</button>
          <div id="prikker" class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2"></div>
        </div>
      </div>

      <!-- SEKTION 3: Hjemmesiden — video + tekst side om side -->
      <div class="fade-in mb-16 flex flex-col lg:flex-row gap-8 items-start">

     <!-- Video -->
<div class="lg:w-200 overflow-hidden">
  <video class="klikbar-video" autoplay muted loop playsinline
         style="width: 120%; height: 100%; object-fit: cover; margin-left: -10%; cursor: zoom-in;">
    <source src="/Billeder/VIDEN/havetgif.mp4" type="video/mp4" />
  </video>
</div>
        <!-- Tekst -->
        <div class="lg:w-1/2 flex flex-col gap-4">
          <h2 style="
  color: #ffffff;
  font-size: 1.1rem;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  text-shadow: 2px 2px 0 #000, -2px -2px 0 #000, 2px -2px 0 #000, -2px 2px 0 #000, 2px 0 0 #000, -2px 0 0 #000, 0 2px 0 #000, 0 -2px 0 #000;
">Gameplay</h2>
<p class="text-base sm:text-lg text-gray-200 leading-relaxed">
  The game was developed in HTML, CSS, and JavaScript. Each level contains interactive objects, animations, sound effects, and short pieces of information that appear as the player progresses through the game.
</p>
        </div>

      </div>

      <!-- SEKTION 4: Visual identity guide -->
      <div class="fade-in mb-4">
        <h2 style="
  color: #ffffff;
  font-size: 1.1rem;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  text-shadow: 2px 2px 0 #000, -2px -2px 0 #000, 2px -2px 0 #000, -2px 2px 0 #000, 2px 0 0 #000, -2px 0 0 #000, 0 2px 0 #000, 0 -2px 0 #000;
">Visual identity</h2>
<p class="text-base sm:text-lg text-gray-200 leading-relaxed mb-6">
  The visual identity is based on Videnskab.dk's existing design but I expanded the visual style with new illustrations, colours, and animations while keeping the overall look recognisable.
</p>

      </div>

      <div class="overflow-hidden mb-16 fade-in">
        <img src="/Billeder/VIDEN/videnvisueltskema.png" alt="SHE CAN PLAY visual identity guide" style="width: 100%;" />
      </div>

  <!-- Credits -->
      <div class="fade-in mb-16" style="border-left: 2px solid #ffffff; padding-left: 1.5rem;">
        <p class="text-sm text-gray-400 leading-relaxed">
          Solo project.<br />
          Role: <span style="color:#ffffff;">Concept development · Game design</span>
        </p>
      </div>

    </div>

    <!-- LIGHTBOX -->
    <div id="lightbox" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.9); z-index:1000; align-items:center; justify-content:center; cursor:zoom-out;">
      <button id="lightboxPrev" style="display:none; position:absolute; left:1.5rem; top:50%; transform:translateY(-50%); color:#000; font-size:2rem; font-weight:bold; background:none; border:none; cursor:pointer; z-index:1010; padding:1rem;">◀</button>
      <img id="lightbox-img" src="" style="max-width:90vw; max-height:90vh; object-fit:contain;" />
      <video id="lightbox-video" muted loop playsinline style="display:none; max-width:90vw; max-height:90vh; object-fit:contain;"></video>
      <button id="lightboxNext" style="display:none; position:absolute; right:1.5rem; top:50%; transform:translateY(-50%); color:#000; font-size:2rem; font-weight:bold; background:none; border:none; cursor:pointer; z-index:1010; padding:1rem;">▶</button>
    </div>

    <footer style="margin-top: 4rem; text-align: center;">
      <p style="color: #ffffff;">© Lærke Buch Nonved portfolio</p>
    </footer>

  </div>

</Layout>

<script is:inline>
  function initIntroVideo() {
    const video = document.getElementById('intro-video');
    if (!video) return;

    const START = 0;
    const END = 115;

    video.addEventListener('loadedmetadata', () => {
      video.currentTime = START;
      video.play();
    });

    video.addEventListener('timeupdate', () => {
      if (video.currentTime >= END) {
        video.currentTime = START;
      }
    });
  }

  function initSheCanPlay() {
    initIntroVideo();

    const visPerSlide = 1;
    let aktuel = 0;
    const billeder = document.querySelectorAll('.karusel-billede');
    const antalSlides = billeder.length;
    const prikContainer = document.getElementById('prikker');
    const karusel = document.getElementById('karusel');

    if (!karusel) return;

    billeder.forEach(img => {
      img.style.width = '100%';
    });

    prikContainer.innerHTML = '';

    function gåTil(index) {
      aktuel = (index + antalSlides) % antalSlides;
      karusel.style.transform = `translateX(-${aktuel * 100}%)`;
      document.querySelectorAll('#prikker div').forEach((p, i) => {
        p.style.background = i === aktuel ? '#ffffff' : 'rgba(255,255,255,0.4)';
      });
    }

    for (let i = 0; i < antalSlides; i++) {
      const prik = document.createElement('div');
      prik.style.cssText = `width:8px; height:8px; border-radius:50%; cursor:pointer; transition:background 0.3s; background:${i === 0 ? '#ffffff' : 'rgba(255,255,255,0.4)'}`;
      prik.addEventListener('click', () => gåTil(i));
      prikContainer.appendChild(prik);
    }

    document.getElementById('aboutPrev').addEventListener('click', () => gåTil(aktuel - 1));
    document.getElementById('aboutNext').addEventListener('click', () => gåTil(aktuel + 1));

    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxVideo = document.getElementById('lightbox-video');
    const lightboxPrev = document.getElementById('lightboxPrev');
    const lightboxNext = document.getElementById('lightboxNext');

    let lightboxIndex = 0;
    let lightboxNavAktiv = false;

    function lukLightbox() {
      lightbox.style.display = 'none';
      lightboxVideo.pause();
      lightboxVideo.style.display = 'none';
      lightboxImg.style.display = 'none';
      lightboxPrev.style.display = 'none';
      lightboxNext.style.display = 'none';
      lightboxNavAktiv = false;
    }

    function visBilledeILightbox(index) {
      lightboxIndex = (index + billeder.length) % billeder.length;
      lightboxNavAktiv = true;
      lightboxVideo.pause();
      lightboxVideo.style.display = 'none';
      lightboxImg.src = billeder[lightboxIndex].src;
      lightboxImg.style.display = 'block';
      lightboxPrev.style.display = 'block';
      lightboxNext.style.display = 'block';
      lightbox.style.display = 'flex';
    }

    // Karusel-billeder → lightbox (med navigation)
    billeder.forEach((img, i) => {
      img.addEventListener('click', () => visBilledeILightbox(i));
    });

    // Stilbillede → lightbox (uden navigation)
    const stillBillede = document.getElementById('still-billede');
    if (stillBillede) {
      stillBillede.addEventListener('click', () => {
        lightboxNavAktiv = false;
        lightboxVideo.pause();
        lightboxVideo.style.display = 'none';
        lightboxPrev.style.display = 'none';
        lightboxNext.style.display = 'none';
        lightboxImg.src = stillBillede.src;
        lightboxImg.style.display = 'block';
        lightbox.style.display = 'flex';
      });
    }

    lightboxPrev.addEventListener('click', (e) => {
      e.stopPropagation();
      visBilledeILightbox(lightboxIndex - 1);
    });

    lightboxNext.addEventListener('click', (e) => {
      e.stopPropagation();
      visBilledeILightbox(lightboxIndex + 1);
    });

    // Videoer → lightbox
    document.querySelectorAll('.klikbar-video').forEach(video => {
      video.addEventListener('click', () => {
        const kilde = video.currentSrc || video.querySelector('source')?.src;
        if (!kilde) return;
        lightboxNavAktiv = false;
        lightboxImg.style.display = 'none';
        lightboxPrev.style.display = 'none';
        lightboxNext.style.display = 'none';
        lightboxVideo.src = kilde;
        lightboxVideo.style.display = 'block';
        lightbox.style.display = 'flex';
        lightboxVideo.play();
      });
    });

    lightbox.addEventListener('click', lukLightbox);

    document.addEventListener('keydown', (e) => {
      if (lightbox.style.display !== 'flex') return;
      if (e.key === 'Escape') lukLightbox();
      if (lightboxNavAktiv) {
        if (e.key === 'ArrowLeft') visBilledeILightbox(lightboxIndex - 1);
        if (e.key === 'ArrowRight') visBilledeILightbox(lightboxIndex + 1);
      }
    });
  }

  document.addEventListener('astro:page-load', initSheCanPlay);
  document.addEventListener('DOMContentLoaded', initSheCanPlay);
</script>