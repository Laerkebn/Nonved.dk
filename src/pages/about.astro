---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="About | My Portfolio" page="about">

  <div class="page-wrapper">

    <!-- HERO -->
     <div class="proj-hero fade-in" style="min-height: 10vh;">
    </div>

    <!-- OM MIG -->
    <div id="about-content" class="fade-in mb-16 lg:mb-24">

      <!-- billede + tekst: side om side på store skærme, stablet på små.
           samme gap på begge akser = altid samme luft imellem dem.
           items-start = teksten flugter med toppen af billedet -->
     <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-10 items-start">

        <!-- billede (øverst på små skærme, venstre på store) -->
        <div>
  <img
  src="/Billeder/pb.webp"
  alt="Lærke Buch Nonved"
  class="block w-full aspect-[4/3] object-cover object-[center_25%] lg:aspect-auto lg:h-auto lg:max-w-[35rem] lg:ml-auto"
/>
        </div>

        <!-- tekst (nederst på små skærme, højre på store) -->
        <div>
          <h2 class="text-3xl font-bold mb-4">Who am I?</h2>
          <div class="space-y-3 text-base leading-relaxed">
            <p>I'm Lærke Buch Nonved, a Danish Visual Communication student specialising in Coded Design at DMJX. My work combines design, technology, and visual storytelling, with a focus on using code to create engaging visual experiences.</p>
            <p>I work with tools such as JavaScript, P5.js, Three.js, Unity, and Astro, but i also explore other mediums and techniques.</p>
            <p>Alongside my studies, I have experience in festival coordination, childcare, and volunteer project management, including helping organise the Mediepuls festival and serving on the Student Council (DSR) at DMJX.</p>
            <p>Whether through digital media, illustration, or physical experiences, I aim to create work that connects with people.</p>
          </div>
        </div>

      </div>
    </div>
<footer style="position: fixed; bottom: 1rem; left: 0; width: 100%; text-align: center; z-index: 20;">
  <p style="color: #ffffff;">© Lærke Buch Nonved portfolio</p>
</footer>

  </div>

</Layout>