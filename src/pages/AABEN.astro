---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="ÅBEN | My Portfolio" page="aaben">

  <div class="page-wrapper">

    <!-- Tilbage knap -->
    <div class="fade-in" style="padding-top: 2rem;">
      <a href="/projects" class="proj-back-btn">← Projects</a>
    </div>

    <!-- TITEL -->
     <div style="
      font-size: clamp(1rem, 5vw, 5rem); 
      font-weight: 900;
      line-height: 0.85;
      letter-spacing: -0.05em;
      color: transparent !important;
      -webkit-text-stroke: 2px #ffffff;

      pointer-events: none;
      word-break: break-word;
      text-align: center;
      margin-top: 2rem;
    ">ÅBEN</div>

    <!-- Tags -->
    <div class="fade-in" style="display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center; padding: 1rem 0 2rem;">
      <span class="proj-tag whitespace-nowrap">Chaikin Curves</span>
      <span class="proj-tag whitespace-nowrap">Asset generator</span>
      <span class="proj-tag whitespace-nowrap">Branding & identity</span>
      <span class="proj-tag whitespace-nowrap">JavaScript</span>

    </div>

    <!-- VIDEO -->
  <div class="proj-gallery-full overflow-hidden mb-8 fade-in" style="background: #464649;">
  <video autoplay muted loop playsinline style="width: 100%; height: 100%; object-fit: cover; transform: scale(1.0);">
    <source src="/Billeder/AABEN/AABEN.mp4" type="video/mp4" />
  </video>
</div>
 
    <!-- ===== PROJEKT INDHOLD ===== -->
    <div id="projekt">

      <!-- SEKTION 1: Intro -->
      <div class="fade-in mb-16">
       <p class="text-base sm:text-lg text-gray-200 leading-relaxed">
  I made a label generator developed as part of a branding and identity project for the Danish craft beer brand ÅBEN. The generator creates unique beer labels based on a set of input values, allowing the visual expression to reflect the characteristics of each beer.
</p>
      </div>

      <!-- SEKTION 2: Generatoren — tekst + karusel side om side -->
      <div class="fade-in mb-16 flex flex-col lg:flex-row gap-8 items-start">

        <!-- Tekst -->
        <div class="lg:w-1/2 flex flex-col gap-4">
         <h2 style="
  color: #ffffff;
  font-size: 1.1rem;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  text-shadow: 2px 2px 0 #000, -2px -2px 0 #000, 2px -2px 0 #000, -2px 2px 0 #000, 2px 0 0 #000, -2px 0 0 #000, 0 2px 0 #000, 0 -2px 0 #000;
">Label generator</h2>
        <p class="text-base sm:text-lg text-gray-200 leading-relaxed">
  The generator translates beer characteristics into visual outcomes through a system of generative patterns and colour combinations.
</p>

<p class="text-base sm:text-lg text-gray-200 leading-relaxed">
  By adjusting values such as alcohol percentage, bitterness, colour, and beer style, each label develops its own visual identity while remaining part of the overall ÅBEN brand.
</p>

<p class="text-base sm:text-lg text-gray-200 leading-relaxed">
  The result is a flexible design system where every label is unique, yet clearly connected to the same visual language.
</p>
        </div>

       <!-- Stilbillede -->
     <div class="lg:w-1/2 w-full">
  <div class="relative overflow-hidden">
    <div id="karusel-still" class="flex transition-transform duration-500 ease-in-out">
       <div class="karusel-billede flex-shrink-0 relative overflow-hidden cursor-pointer" style="height: 340px; width: 100%;" data-src="/Billeder/AABEN/all.jpeg">
        <img src="/Billeder/AABEN/all.jpeg" aria-hidden="true" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:blur(20px) brightness(0.7); transform:scale(1.1);" />
        <img src="/Billeder/AABEN/all.jpeg" class="karusel-forgrund hover:opacity-80 transition-opacity duration-300" style="position:relative; width:100%; height:100%; object-fit:contain;" />
      </div>
      <div class="karusel-billede flex-shrink-0 relative overflow-hidden cursor-pointer" style="height: 340px; width: 100%;" data-src="/Billeder/AABEN/nødt.jpeg">
        <img src="/Billeder/AABEN/nødt.jpeg" aria-hidden="true" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:blur(20px) brightness(0.7); transform:scale(1.1);" />
        <img src="/Billeder/AABEN/nødt.jpeg" class="karusel-forgrund hover:opacity-80 transition-opacity duration-300" style="position:relative; width:100%; height:100%; object-fit:contain;" />
      </div>
      <div class="karusel-billede flex-shrink-0 relative overflow-hidden cursor-pointer" style="height: 340px; width: 100%;" data-src="/Billeder/AABEN/AABENSTART.jpeg">
        <img src="/Billeder/AABEN/AABENSTART.jpeg" aria-hidden="true" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:blur(20px) brightness(0.7); transform:scale(1.1);" />
        <img src="/Billeder/AABEN/AABENSTART.jpeg" class="karusel-forgrund hover:opacity-80 transition-opacity duration-300" style="position:relative; width:100%; height:100%; object-fit:contain;" />
      </div>
      <div class="karusel-billede flex-shrink-0 relative overflow-hidden cursor-pointer" style="height: 340px; width: 100%;" data-src="/Billeder/AABEN/lime.jpeg">
        <img src="/Billeder/AABEN/lime.jpeg" aria-hidden="true" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:blur(20px) brightness(0.7); transform:scale(1.1);" />
        <img src="/Billeder/AABEN/lime.jpeg" class="karusel-forgrund hover:opacity-80 transition-opacity duration-300" style="position:relative; width:100%; height:100%; object-fit:contain;" />
      </div>
      <div class="karusel-billede flex-shrink-0 relative overflow-hidden cursor-pointer" style="height: 340px; width: 100%;" data-src="/Billeder/AABEN/blomme.jpeg">
        <img src="/Billeder/AABEN/blomme.jpeg" aria-hidden="true" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:blur(20px) brightness(0.7); transform:scale(1.1);" />
        <img src="/Billeder/AABEN/blomme.jpeg" class="karusel-forgrund hover:opacity-80 transition-opacity duration-300" style="position:relative; width:100%; height:100%; object-fit:contain;" />
      </div>
    </div>
    <button id="stillPrev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white px-4 py-3 transition-all duration-300 hover:scale-140 text-xl font-bold z-10">◀</button>
    <button id="stillNext" class="absolute right-4 top-1/2 -translate-y-1/2 text-white px-4 py-3 transition-all duration-300 hover:scale-140 text-xl font-bold z-10">▶</button>
    <div id="prikker-still" class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2"></div>
  </div>
</div>

      </div>

  <!-- SEKTION: Karusel -->
      <div class="fade-in mb-16">
        <div class="relative overflow-hidden">
          <div id="karusel" class="flex transition-transform duration-500 ease-in-out">
   <img src="/Billeder/AABEN/label1.png" class="karusel-billede flex-shrink-0 object-contain cursor-pointer hover:opacity-80 transition-opacity duration-300" style="height: 440px; background: #EEE7DB;;" />
    <img src="/Billeder/AABEN/label2.png" class="karusel-billede flex-shrink-0 object-contain cursor-pointer hover:opacity-80 transition-opacity duration-300" style="height: 440px; background: #EEE7DB;" />
           <img src="/Billeder/AABEN/label3.png" class="karusel-billede flex-shrink-0 object-contain cursor-pointer hover:opacity-80 transition-opacity duration-300" style="height: 440px; background: #EEE7DB;" />
           <img src="/Billeder/AABEN/label4.png" class="karusel-billede flex-shrink-0 object-contain cursor-pointer hover:opacity-80 transition-opacity duration-300" style="height: 440px; background: #EEE7DB;" />
              <img src="/Billeder/AABEN/label5.png" class="karusel-billede flex-shrink-0 object-contain cursor-pointer hover:opacity-80 transition-opacity duration-300" style="height: 440px; background: #EEE7DB;" />
                 <img src="/Billeder/AABEN/label6.png" class="karusel-billede flex-shrink-0 object-contain cursor-pointer hover:opacity-80 transition-opacity duration-300" style="height: 440px; background: #EEE7DB;" />      
  </div>
          <button id="aboutPrev" class="absolute left-4 top-1/2 -translate-y-1/2 text-black px-4 py-3 transition-all duration-300 hover:scale-140 text-xl font-bold z-10">◀</button>
          <button id="aboutNext" class="absolute right-4 top-1/2 -translate-y-1/2 text-black px-4 py-3 transition-all duration-300 hover:scale-140 text-xl font-bold z-10">▶</button>
          <div id="prikker" class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2"></div>
        </div>
      </div>

  <!-- SEKTION 3: Her vises en video af chaikin curves og hvordan de virker — video + tekst side om side -->
      <div class="fade-in mb-16 flex flex-col lg:flex-row gap-8 items-start">

        <!-- Video -->
        <div class="lg:w-200 overflow-hidden">
        <video class="klikbar-video" autoplay muted loop playsinline style="width: 100%; height: 100%; object-fit: cover; cursor: zoom-in;">
  <source src="/Billeder/AABEN/ChaikinCurves.mp4" type="video/mp4" />
</video>
        </div>

        <!-- Tekst -->
        <div class="lg:w-1/2 flex flex-col gap-4">
          <h2 style="
  color: #ffffff;
  font-size: 1.1rem;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  text-shadow: 2px 2px 0 #000, -2px -2px 0 #000, 2px -2px 0 #000, -2px 2px 0 #000, 2px 0 0 #000, -2px 0 0 #000, 0 2px 0 #000, 0 -2px 0 #000;
">Chaikin Curves</h2>
        <p class="text-base sm:text-lg text-gray-200 leading-relaxed">
  The generative patterns are built using Chaikin Curves, an algorithm that transforms angular lines into smooth organic shapes through repeated subdivision.
</p>
<p class="text-base sm:text-lg text-gray-200 leading-relaxed">
  By experimenting with different curve parameters, I developed a visual system capable of producing a wide range of unique patterns while maintaining a consistent aesthetic across the label collection.
</p>
        </div>

      </div>

      <!-- SEKTION 4: Visual identity guide -->
      <div class="fade-in mb-4">
        <h2 style="
  color: #ffffff;
  font-size: 1.1rem;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  text-shadow: 2px 2px 0 #000, -2px -2px 0 #000, 2px -2px 0 #000, -2px 2px 0 #000, 2px 0 0 #000, -2px 0 0 #000, 0 2px 0 #000, 0 -2px 0 #000;
">Visual identity</h2>
       <p class="text-base sm:text-lg text-gray-200 leading-relaxed mb-6">
  The visual identity guide documents the design system developed for ÅBEN, including typography, colour principles, label structure, and the generative patterns that define the brand's visual expression.
</p>
      </div>

      <div class="overflow-hidden mb-16 fade-in">
        <img src="/Billeder/AABEN/Aabenvisueltskema.png" alt="Aaben visual identity guide" style="width: 100%;" />
      </div>

    
      <!-- Credits -->
      <div class="fade-in mb-16" style="border-left: 2px solid #ffffff; padding-left: 1.5rem;">
        <p class="text-sm text-gray-400 leading-relaxed">
          Solo project.<br />
          Role: <span style="color:#ffffff;">Concept development · Asset generator design</span>
        </p>
      </div>

    </div>

    <!-- LIGHTBOX -->
    <div id="lightbox" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.9); z-index:1000; align-items:center; justify-content:center; cursor:zoom-out;">
      <button id="lightboxPrev" style="display:none; position:absolute; left:1.5rem; top:50%; transform:translateY(-50%); color:#000; font-size:2rem; font-weight:bold; background:none; border:none; cursor:pointer; z-index:1010; padding:1rem;">◀</button>
      <img id="lightbox-img" src="" style="max-width:90vw; max-height:90vh; object-fit:contain;" />
      <video id="lightbox-video" muted loop playsinline style="display:none; max-width:90vw; max-height:90vh; object-fit:contain;"></video>
      <button id="lightboxNext" style="display:none; position:absolute; right:1.5rem; top:50%; transform:translateY(-50%); color:#000; font-size:2rem; font-weight:bold; background:none; border:none; cursor:pointer; z-index:1010; padding:1rem;">▶</button>
    </div>

    <footer style="margin-top: 4rem; text-align: center;">
      <p style="color: #ffffff;">© Lærke Buch Nonved portfolio</p>
    </footer>

  </div>

</Layout>
<script is:inline>
  let lightbox, lightboxImg, lightboxVideo, lightboxPrev, lightboxNext;
  let aktivtSæt = [];
  let lightboxIndex = 0;
  let lightboxNavAktiv = false;
  let lyttereSat = false;

  function lukLightbox() {
    lightbox.style.display = 'none';
    lightboxVideo.pause();
    lightboxVideo.style.display = 'none';
    lightboxImg.style.display = 'none';
    lightboxPrev.style.display = 'none';
    lightboxNext.style.display = 'none';
    lightboxNavAktiv = false;
  }

  function visBilledeILightbox(index) {
    lightboxIndex = (index + aktivtSæt.length) % aktivtSæt.length;
    lightboxNavAktiv = aktivtSæt.length > 1;
    lightboxVideo.pause();
    lightboxVideo.style.display = 'none';
    lightboxImg.src = aktivtSæt[lightboxIndex].dataset.src || aktivtSæt[lightboxIndex].src;
    lightboxImg.style.display = 'block';
    lightboxPrev.style.display = lightboxNavAktiv ? 'block' : 'none';
    lightboxNext.style.display = lightboxNavAktiv ? 'block' : 'none';
    lightbox.style.display = 'flex';
  }

  function opsætKarusel(karuselId, prevId, nextId, prikId, perVisning = 1) {
    const karusel = document.getElementById(karuselId);
    if (!karusel) return;
    const billeder = karusel.querySelectorAll('.karusel-billede');
    const antal = billeder.length;
    const prikContainer = document.getElementById(prikId);
    let aktuel = 0;

    billeder.forEach(img => { img.style.width = `${100 / perVisning}%`; });
    prikContainer.innerHTML = '';

    const antalTrin = Math.max(1, antal - perVisning + 1);

    function gåTil(index) {
      aktuel = (index + antalTrin) % antalTrin;
      karusel.style.transform = `translateX(-${aktuel * (100 / perVisning)}%)`;
      prikContainer.querySelectorAll('div').forEach((p, i) => {
        p.style.background = i === aktuel ? '#ffffff' : 'rgba(255,255,255,0.4)';
      });
    }

    for (let i = 0; i < antalTrin; i++) {
      const prik = document.createElement('div');
      prik.style.cssText = `width:8px; height:8px; border-radius:50%; cursor:pointer; transition:background 0.3s; background:${i === 0 ? '#ffffff' : 'rgba(255,255,255,0.4)'}`;
      prik.addEventListener('click', () => gåTil(i));
      prikContainer.appendChild(prik);
    }

    // Klon knapperne for at fjerne gamle listeners (undgår dobbelt-binding)
    const prevBtn = document.getElementById(prevId);
    const nextBtn = document.getElementById(nextId);
    const prevNy = prevBtn.cloneNode(true);
    const nextNy = nextBtn.cloneNode(true);
    prevBtn.replaceWith(prevNy);
    nextBtn.replaceWith(nextNy);
    prevNy.addEventListener('click', () => gåTil(aktuel - 1));
    nextNy.addEventListener('click', () => gåTil(aktuel + 1));

    billeder.forEach((slide, i) => {
      slide.addEventListener('click', () => {
        aktivtSæt = Array.from(billeder);
        visBilledeILightbox(i);
      });
    });
  }

  function initSheCanPlay() {
    lightbox = document.getElementById('lightbox');
    lightboxImg = document.getElementById('lightbox-img');
    lightboxVideo = document.getElementById('lightbox-video');
    lightboxPrev = document.getElementById('lightboxPrev');
    lightboxNext = document.getElementById('lightboxNext');
    if (!lightbox) return;

    opsætKarusel('karusel', 'aboutPrev', 'aboutNext', 'prikker', 2);
    opsætKarusel('karusel-still', 'stillPrev', 'stillNext', 'prikker-still');

    document.querySelectorAll('.klikbar-video').forEach(video => {
      video.addEventListener('click', () => {
        const kilde = video.currentSrc || video.querySelector('source')?.src;
        if (!kilde) return;
        lightboxNavAktiv = false;
        lightboxImg.style.display = 'none';
        lightboxPrev.style.display = 'none';
        lightboxNext.style.display = 'none';
        lightboxVideo.src = kilde;
        lightboxVideo.style.display = 'block';
        lightbox.style.display = 'flex';
        lightboxVideo.play();
      });
    });

    if (!lyttereSat) {
      lyttereSat = true;

      lightboxPrev.addEventListener('click', (e) => { e.stopPropagation(); visBilledeILightbox(lightboxIndex - 1); });
      lightboxNext.addEventListener('click', (e) => { e.stopPropagation(); visBilledeILightbox(lightboxIndex + 1); });
      lightbox.addEventListener('click', lukLightbox);

      document.addEventListener('keydown', (e) => {
        if (lightbox.style.display !== 'flex') return;
        if (e.key === 'Escape') lukLightbox();
        if (lightboxNavAktiv) {
          if (e.key === 'ArrowLeft') visBilledeILightbox(lightboxIndex - 1);
          if (e.key === 'ArrowRight') visBilledeILightbox(lightboxIndex + 1);
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initSheCanPlay);
  document.addEventListener('DOMContentLoaded', initSheCanPlay);
</script>