---
// Fælles layout for alle sider. Hver side sender en `title` og en `page`-prop ind,
// så vi kan vælge den rigtige baggrunds-overlay (se nedenfor).
import { ClientRouter } from 'astro:transitions';
const { title = 'My Portfolio', page = '' } = Astro.props;
import '../styles/global.css';

// Statiske sider (about/projects/contact) får en halvgennemsigtig sort overlay
// oven på baggrundsvideoen, så teksten kan læses.
const isStaticPage = page === 'about' || page === 'projects' || page === 'contact';
// Projektsider får en helt sort baggrund i stedet — og en loading-skærm.
const isProjectPage = page === 'grums' || page === 'aaben' || page === 'fez' || page === 'metro' || page === 'shecanplay' || page === 'viden';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfolio of Lærke Buch Nonved — Visual Communication student specialising in Coded Design at DMJX." />
    <meta name="author" content="Lærke Buch Nonved" />
    <!-- Favicon (ikonet i browserfanen). ?v=2 tvinger browseren til at hente
         den nye fil i stedet for en gammel cachet udgave. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <title>{title}</title>
    <ClientRouter />
  </head>

  <body>
    <!-- LOADING-SKÆRM (kun projektsider).
         Ligger øverst af alt og fjernes først, når sidens billeder og videoer
         er hentet. Se scriptet nederst. -->
    {isProjectPage && (
      <div id="loader" role="status" aria-live="polite" aria-label="Loading project">
        <div class="loader-indhold">
          <div class="loader-label">Loading</div>
          <div class="loader-bjaelke"><span></span></div>
        </div>
      </div>
    )}

    <!-- Baggrunds-overlays: vælges ud fra hvilken type side vi er på (se frontmatter) -->
    {isStaticPage && (
      <div style="position: fixed; inset: 0; background: rgba(0,0,0,0.70); z-index: 5;"></div>
    )}
     {isProjectPage && (
      <div style="position: fixed; inset: 0; background: #000; z-index: 5;"></div>
    )}

    <!-- Baggrundslyd. transition:persist sikrer at afspilningen IKKE genstarter
         når man navigerer mellem sider (Astro genbruger samme <audio>-element).
         Bemærk: browsere blokerer autoplay med lyd, så lyden starter først efter
         brugeren har interageret med siden. -->
    <audio id="bg-audio" loop transition:persist>
      <source src="/music/fugle.mp3" type="audio/mp3" />
    </audio>

    <!-- Top navigation -->
    <header class="top-bar">
      <nav
        class="text-xs sm:text-sm md:text-base lg:text-sm bar-box bg-[#272425]/80 text-[#ffffff] flex justify-evenly w-full uppercase tracking-widest font-semibold"
        style="text-shadow: 2px 2px 0 #000, -2px -2px 0 #000, 2px -2px 0 #000, -2px 2px 0 #000, 2px 0 0 #000, -2px 0 0 #000, 0 2px 0 #000, 0 -2px 0 #000;"
      >
        <a href="/" class=" transition duration-300 hover:scale-110">Home</a>
        <a href="/about" class=" transition duration-300 hover:scale-110">About</a>
        <a href="/projects" class=" transition duration-300 hover:scale-110">Projects</a>
        <a href="/contact" class=" transition duration-300 hover:scale-110">Contact</a>
      </nav>
    </header>

    <!-- Main page area -->
    <main class="page-content">
      <slot />
    </main>

    <script is:inline>
      (function () {
        /* -----------------------------------------------------------------
         * Dette script ligger i <body> og bliver derfor kørt igen ved hver
         * klient-navigation. window-flaget sikrer, at vi kun registrerer
         * vores lyttere ÉN gang — ellers hober de sig op side for side.
         * --------------------------------------------------------------- */
        if (window.__portefoljeMotor) return;
        window.__portefoljeMotor = true;

        const MIN_TID = 500;    // loaderen vises mindst så længe (undgår et glimt)
        const MAKS_TID = 8000;  // ... og aldrig længere, uanset hvad der driller

        // Peger på den loader-node, vi sidst gik i gang med. Ved view transitions
        // udskiftes DOM'en, så noden er ny på hver side — det gør det nemt at se,
        // om siden allerede er sat i gang.
        let sidstSet = null;

        // Fade-in animation: alle elementer med klassen .fade-in glider blødt ind,
        // når de kommer i syne. Køres FØRST når loaderen forsvinder — ellers når
        // de øverste sektioner at animere sig færdige bag den sorte skærm.
        function initFadeIn() {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(el => {
              if (el.isIntersecting) {
                el.target.classList.add('visible');
                observer.unobserve(el.target);
              }
            });
          }, { threshold: 0 });
          document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
        }

        // Har videoen overhovedet en kilde? Lightbox-videoen står tom, indtil
        // man klikker på noget — den skal hverken vækkes eller ventes på.
        function harKilde(video) {
          return !!(video.getAttribute('src') || video.querySelector('source[src]'));
        }

        /* -----------------------------------------------------------------
         * Ved klient-navigation bliver DOM'en bygget af Astro og flyttet ind
         * i siden. En <video autoplay>, der ankommer den vej, starter ikke af
         * sig selv — browseren reagerer kun på autoplay for elementer, den
         * selv har parset. Derfor sparker vi dem i gang manuelt.
         * Det er grunden til, at videoerne først dukkede op efter et reload.
         * --------------------------------------------------------------- */
        function vaekVideoer() {
          document.querySelectorAll('video').forEach(video => {
            if (!harKilde(video)) return;
            // readyState 0 = browseren er slet ikke begyndt at hente
            if (video.readyState === 0) video.load();
            if (video.hasAttribute('autoplay')) video.play().catch(() => {});
          });
        }

        // Alt det, vi venter på. Lazy-billeder springes over — de hentes først,
        // når man scroller ned til dem, så det ville aldrig blive færdigt.
        function medierPåSiden() {
          const billeder = Array.from(document.querySelectorAll('img'))
            .filter(img => img.loading !== 'lazy' && img.getAttribute('src'));
          const videoer = Array.from(document.querySelectorAll('video'))
            .filter(harKilde);
          return billeder.concat(videoer);
        }

        // Løser sig, når ét element er klar. Fejler billedet, tæller det også som
        // klar — et brudt link må ikke låse hele siden.
        function venterPå(el) {
          return new Promise(resolve => {
            if (el.tagName === 'IMG') {
              if (el.complete && el.naturalWidth > 0) return resolve();
              el.addEventListener('load', resolve, { once: true });
              el.addEventListener('error', resolve, { once: true });
            } else {
              // readyState >= 2 betyder, at første frame er klar til visning
              if (el.readyState >= 2) return resolve();
              el.addEventListener('loadeddata', resolve, { once: true });
              el.addEventListener('error', resolve, { once: true });
            }
          });
        }

        function start() {
          const loader = document.getElementById('loader');

          vaekVideoer();

          // Ikke en projektside → ingen loader, bare fade-in som før.
          if (!loader) { initFadeIn(); return; }

          // Denne DOM er allerede sat i gang.
          if (sidstSet === loader) return;
          sidstSet = loader;

          const bjaelke = loader.querySelector('.loader-bjaelke span');
          const startTid = Date.now();

          document.body.style.overflow = 'hidden';   // ingen scroll bag loaderen

          const medier = medierPåSiden();
          const ialt = medier.length;
          let klar = 0;
          let afsluttet = false;

          function opdater() {
            const pct = ialt === 0 ? 100 : Math.round((klar / ialt) * 100);
            if (bjaelke) bjaelke.style.width = pct + '%';
          }

          function afslut() {
            if (afsluttet) return;
            afsluttet = true;

            klar = ialt;
            opdater();

            const gaaet = Date.now() - startTid;
            setTimeout(() => {
              loader.classList.add('faerdig');
              document.body.style.overflow = '';
              initFadeIn();
              // Fjern den helt, når udtoningen er ovre
              setTimeout(() => { loader.style.display = 'none'; }, 600);
            }, Math.max(0, MIN_TID - gaaet));
          }

          opdater();

          medier.forEach(el => venterPå(el).then(() => {
            klar++;
            opdater();
            if (klar >= ialt) afslut();
          }));

          if (ialt === 0) afslut();
          setTimeout(afslut, MAKS_TID);   // nødbremse
        }

        // astro:page-load fyrer ved første load OG efter hver klient-navigation.
        document.addEventListener('astro:page-load', start);
        // Sikkerhedsnet, hvis page-load mod forventning ikke når at fyre.
        setTimeout(start, 300);
      })();
    </script>

    <style>
      #loader {
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: #000;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.6s ease;
      }

      #loader.faerdig {
        opacity: 0;
        pointer-events: none;
      }

      .loader-indhold {
        text-align: center;
        width: min(320px, 70vw);
      }

      .loader-label {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.4em;
        text-transform: uppercase;
        text-indent: 0.4em;   /* modvirker det ekstra mellemrum efter sidste bogstav */
      }

      .loader-bjaelke {
        margin-top: 1.25rem;
        height: 1px;
        background: rgba(255, 255, 255, 0.25);
      }

      .loader-bjaelke span {
        display: block;
        height: 100%;
        width: 0;
        background: #ffffff;
        transition: width 0.3s ease;
      }

      @media (prefers-reduced-motion: reduce) {
        #loader,
        .loader-bjaelke span {
          transition: none;
        }
      }
    </style>

  </body>
</html>